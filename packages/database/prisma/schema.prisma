// ============================================================================
// @file packages/database/prisma/schema.prisma
// @module @etheria/database
// @description Modelagem Oficial PostgreSQL do Etheria Campus (Low-Code & Motor Procedural).
// @rules
//   1. Regra da Curadoria (Whitelist): Só existe no jogo o que está salvo nestas tabelas.
//   2. Mapas importam apenas a imagem base do mcrework; as áreas de colisão (collisionMeshJson)
//      e áreas de sobreposição/opacidade (overlapMeshJson) são editadas visualmente no /admin.
//   3. Biomas (40) servem exclusivamente para o cruzamento procedural Mapa <-> Bioma <-> Monstro.
//   4. Elementos (5: FIRE, EARTH, AIR, WATER, NEUTRAL) e Raças (11) pertencem às entidades.
//   5. Personagens possuem 16 slots de equipamento (incluindo BELT); Pets possuem 6 slots.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. INTERNACIONALIZAÇÃO (i18n)
// ----------------------------------------------------------------------------

/// Armazena todas as traduções de nomes e descrições dinâmicas do banco (pt-BR, en-US, es-ES).
model I18nTranslation {
  id        Int      @id @default(autoincrement())
  key       String   @map("i18n_key")
  locale    String   @default("pt-BR")
  text      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, locale])
  @@index([key])
  @@map("i18n_translations")
}

// ----------------------------------------------------------------------------
// 2. MUNDO PROCEDURAL: BIOMAS (40), TIPOS DE MAPA (5), MAPAS, PORTAIS E NPCS
// ----------------------------------------------------------------------------

/// Os 40 Biomas do mundo. Função exclusiva: cruzamento procedural Mapa <-> Bioma <-> Monstro.
model Biome {
  id                 Int            @id @default(autoincrement())
  code               String         @unique
  category           String         /// Ex: FOREST, ARID, AQUATIC, GLACIAL, VOLCANIC, UNDEAD, ARCANE
  nameI18nKey        String         @map("name_i18n_key")
  descriptionI18nKey String         @map("description_i18n_key")
  primaryMaps        GameMap[]      @relation("PrimaryBiome")
  secondaryMaps      GameMap[]      @relation("SecondaryBiome")
  monsterBiomes      MonsterBiome[]

  @@map("biomes")
}

/// Os 5 Tipos de Mapa (CITY, VILLAGE, SUBURB, HOSTILE_ZONE, CONFLICT_ZONE).
/// Fixam quem pode dominar (ALLIANCE vs FACTION), se spawna monstros e a regra de PvP.
model MapType {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique /// CITY, VILLAGE, SUBURB, HOSTILE_ZONE, CONFLICT_ZONE
  nameI18nKey          String    @map("name_i18n_key")
  dominationTarget     String    @map("domination_target") /// ALLIANCE (Cidades/Vilas) ou FACTION (Subúrbio/Hostil/Conflito)
  allowMonsterSpawn    Boolean   @default(false) @map("allow_monster_spawn")
  pvpRule              String    @map("pvp_rule") /// DUEL_ONLY, FORCED_PK, OPEN_PVP
  forcesCriminalStatus Boolean   @default(false) @map("forces_criminal_status") /// true na HOSTILE_ZONE quando força PK
  maps                 GameMap[]

  @@map("map_types")
}

/// Tabela de Mapas curados no /admin.
/// Importa somente a imagem limpa do mcrework e armazena as malhas de colisão e sobreposição desenhadas à mão.
model GameMap {
  id                Int         @id @default(autoincrement())
  code              String      @unique
  mcreworkMapImage  String      @map("mcrework_map_image") /// Caminho da imagem limpa do mapa no mcrework
  nameI18nKey       String      @map("name_i18n_key")
  requiredLevel     Int         @default(1) @map("required_level") /// Ex: 1, 10, 20, 30...
  levelVarianceMin  Int         @default(-2) @map("level_variance_min")
  levelVarianceMax  Int         @default(5) @map("level_variance_max")
  mapTypeId         Int         @map("map_type_id")
  primaryBiomeId    Int         @map("primary_biome_id")
  secondaryBiomeId  Int         @map("secondary_biome_id")
  encounterRatePct  Float       @default(8.0) @map("encounter_rate_pct") /// Taxa base de encontro com monstros por passo (%)
  allowedMonsterRacesJson       Json        @default("[]") @map("allowed_monster_races_json") /// Raças/Tipos de monstros que nascem no mapa (ex: ["BEAST", "DRAGON", "HUMAN"])
  allowedMonsterTemplateIdsJson Json        @default("[]") @map("allowed_monster_template_ids_json") /// IDs de monstros individuais fora dos tipos (ex: [1, 5, 23])
  dominatedById     String?     @map("dominated_by_id") /// ID da Aliança ou Facção dominante (sistema de domínio/guerra)
  spawnX            Float       @default(500) @map("spawn_x") /// Ponto de Spawn padrão (Novatos no Mapa 1, Itens de Teleporte, Respawn em Cidade/Vila e Destravar Personagem)
  spawnY            Float       @default(500) @map("spawn_y") /// Coordenada Y do Ponto de Spawn padrão do mapa
  collisionMeshJson Json        @default("[]") @map("collision_mesh_json") /// Áreas editáveis onde o personagem colide
  overlapMeshJson   Json        @default("[]") @map("overlap_mesh_json") /// Áreas editáveis acima do personagem que reduzem sua opacidade
  overlapOpacity    Float       @default(0.45) @map("overlap_opacity") /// Opacidade aplicada à região coberta do corpo do personagem
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  mapType           MapType     @relation(fields: [mapTypeId], references: [id])
  primaryBiome      Biome       @relation("PrimaryBiome", fields: [primaryBiomeId], references: [id])
  secondaryBiome    Biome       @relation("SecondaryBiome", fields: [secondaryBiomeId], references: [id])
  outgoingPortals   MapPortal[] @relation("SourceMapPortals")
  incomingPortals   MapPortal[] @relation("TargetMapPortals")
  npcs              MapNpc[]

  @@map("maps")
}

/// Pontos de Teleporte em Duplas Interligadas (Entrada <-> Saída).
/// Ao entrar em um portal de um lado, o jogador sai obrigatoriamente na posição do portal par do outro lado.
model MapPortal {
  id             Int        @id @default(autoincrement())
  label          String     @default("Portal") /// Nome identificador no editor (ex: "Portal Norte")
  sourceMapId    Int        @map("source_map_id")
  sourceX        Float      @map("source_x")
  sourceY        Float      @map("source_y")
  triggerRadius  Float      @default(48) @map("trigger_radius")
  linkedPortalId Int?       @map("linked_portal_id") /// ID do portal par no mapa de destino (vínculo bidirecional)
  targetMapId    Int?       @map("target_map_id") /// Mapa de destino (opcional enquanto o portal par ainda não foi vinculado)
  targetX        Float      @default(500) @map("target_x") /// Coordenada X de saída (sincronizada com o sourceX do portal par)
  targetY        Float      @default(500) @map("target_y") /// Coordenada Y de saída (sincronizada com o sourceY do portal par)
  portalVfxKey   String?    @map("portal_vfx_key")

  sourceMap      GameMap    @relation("SourceMapPortals", fields: [sourceMapId], references: [id], onDelete: Cascade)
  targetMap      GameMap?   @relation("TargetMapPortals", fields: [targetMapId], references: [id], onDelete: SetNull)

  @@map("map_portals")
}

/// Templates de NPCs (podem ser enfeites de cenário ou gatilhos para quests, lojas, lutas/boss/treinador, eventos).
model NpcTemplate {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  mcreworkNpcKey   String   @map("mcrework_npc_key")
  nameI18nKey      String   @map("name_i18n_key")
  isDecorationOnly Boolean  @default(false) @map("is_decoration_only")
  triggersJson     Json     @default("[]") @map("triggers_json") /// Ex: [{type: "QUEST"|"SHOP"|"BATTLE"|"EVENT", config: {...}}]
  placements       MapNpc[]

  @@map("npc_templates")
}

/// Posicionamento de um NPC dentro de um mapa específico.
model MapNpc {
  id                       Int         @id @default(autoincrement())
  mapId                    Int         @map("map_id")
  npcTemplateId            Int         @map("npc_template_id")
  posX                     Float       @map("pos_x")
  posY                     Float       @map("pos_y")
  direction                Int         @default(0) /// Direção inicial (0..7)
  teleportDestinationsJson Json?       @map("teleport_destinations_json") /// Destinos de teleporte do NPC: [{label, targetMapId, targetX, targetY, requiredLevel, costGold}]

  map                      GameMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  npcTemplate              NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)

  @@map("map_npcs")
}

// ----------------------------------------------------------------------------
// 3. ELEMENTOS (5) E RAÇAS (11) VINCULADOS ÀS ENTIDADES
// ----------------------------------------------------------------------------

/// Os 5 Elementos: FIRE, EARTH, AIR, WATER e NEUTRAL (penalizado).
model Element {
  code               String           @id /// FIRE, EARTH, AIR, WATER, NEUTRAL
  nameI18nKey        String           @map("name_i18n_key")
  initialRollChance  Float            @map("initial_roll_chance") /// NEUTRAL = 0.10 (10%), Ativos = 0.20 (20% peso relativo)
  attackerMatchups   ElementMatchup[] @relation("AttackerElement")
  defenderMatchups   ElementMatchup[] @relation("DefenderElement")
  monsters           MonsterTemplate[]
  pets               PetTemplate[]

  @@map("elements")
}

/// Matriz de multiplicadores de dano entre Elementos (Vantagem +25%, Desvantagem -25%, Neutro penalizado em ambos).
model ElementMatchup {
  id                  Int     @id @default(autoincrement())
  attackerElementCode String  @map("attacker_element_code")
  defenderElementCode String  @map("defender_element_code")
  damageMultiplier    Float   @default(1.0) @map("damage_multiplier") /// Ex: 1.25 (+25%), 0.75 (-25%), etc.

  attackerElement     Element @relation("AttackerElement", fields: [attackerElementCode], references: [code])
  defenderElement     Element @relation("DefenderElement", fields: [defenderElementCode], references: [code])

  @@unique([attackerElementCode, defenderElementCode])
  @@map("element_matchups")
}

/// As 11 Raças: HUMAN + Ciclo de 10 Raças (PLANT > DRAGON > REPTILIAN > AQUATIC > ROBOTIC > CELESTIAL > DEMON > FAIRY > SPIRIT > BEAST > PLANT).
model Race {
  code             String            @id
  nameI18nKey      String            @map("name_i18n_key")
  attackerMatchups RaceMatchup[]     @relation("AttackerRace")
  defenderMatchups RaceMatchup[]     @relation("DefenderRace")
  classes          ClassTemplate[]
  monsters         MonsterTemplate[]
  pets             PetTemplate[]

  @@map("races")
}

/// Matriz de vantagem racial (+10% de vantagem para HUMAN sobre todas e +10% no ciclo das 10 raças).
model RaceMatchup {
  id               Int    @id @default(autoincrement())
  attackerRaceCode String @map("attacker_race_code")
  defenderRaceCode String @map("defender_race_code")
  damageMultiplier Float  @default(1.0) @map("damage_multiplier") /// Ex: 1.10 (+10%) ou 0.90 (-10%)

  attackerRace     Race   @relation("AttackerRace", fields: [attackerRaceCode], references: [code])
  defenderRace     Race   @relation("DefenderRace", fields: [defenderRaceCode], references: [code])

  @@unique([attackerRaceCode, defenderRaceCode])
  @@map("race_matchups")
}

// ----------------------------------------------------------------------------
// 4. ATRIBUTOS PROCEDURAIS (BASE -> COMBATE)
// ----------------------------------------------------------------------------

/// Os 6 Atributos Base: VIT, STR, INT, WIS, AGI, DEX.
model BaseAttribute {
  code               String                @id
  nameI18nKey        String                @map("name_i18n_key")
  descriptionI18nKey String                @map("description_i18n_key")
  conversions        AttributeConversion[]

  @@map("base_attributes")
}

/// Atributos Derivados de Combate (MAX_HP, MAX_MP, PHYS_ATK, MAG_ATK, PHYS_DEF, MAG_DEF, SPEED, CRIT_RATE, etc.).
model CombatAttribute {
  code         String                @id
  nameI18nKey  String                @map("name_i18n_key")
  baseDefault  Float                 @default(0) @map("base_default")
  isPercentage Boolean               @default(false) @map("is_percentage")
  conversions  AttributeConversion[]

  @@map("combat_attributes")
}

/// Matriz Procedural: define quanto 1 ponto de um Atributo Base concede em cada Atributo de Combate.
model AttributeConversion {
  id                  Int             @id @default(autoincrement())
  baseAttributeCode   String          @map("base_attribute_code")
  combatAttributeCode String          @map("combat_attribute_code")
  ratioPerPoint       Float           @map("ratio_per_point") /// Ex: 1 VIT -> +20 MAX_HP

  baseAttribute       BaseAttribute   @relation(fields: [baseAttributeCode], references: [code], onDelete: Cascade)
  combatAttribute     CombatAttribute @relation(fields: [combatAttributeCode], references: [code], onDelete: Cascade)

  @@unique([baseAttributeCode, combatAttributeCode])
  @@map("attribute_conversions")
}

// ----------------------------------------------------------------------------
// 5. ENTIDADES: CLASSES DE PERSONAGEM, RARIDADES E MONSTROS/PETS
// ----------------------------------------------------------------------------

/// Templates de Classes/Personagens jogáveis curados do mcrework.
model ClassTemplate {
  id                    Int               @id @default(autoincrement())
  code                  String            @unique
  mcreworkCharKey       String            @map("mcrework_char_key")
  nameI18nKey           String            @map("name_i18n_key")
  descriptionI18nKey    String?           @map("description_i18n_key")
  rebornMcreworkCharKey String?           @map("reborn_mcrework_char_key")
  groundOffsetY         Int               @default(0) @map("ground_offset_y")
  rebornGroundOffsetY   Int               @default(0) @map("reborn_ground_offset_y")
  shadowOffsetX         Int               @default(0) @map("shadow_offset_x")
  shadowOffsetY         Int               @default(0) @map("shadow_offset_y")
  rebornShadowOffsetX   Int               @default(0) @map("reborn_shadow_offset_x")
  rebornShadowOffsetY   Int               @default(0) @map("reborn_shadow_offset_y")
  raceCode              String            @default("HUMAN") @map("race_code")
  combatStyle           String            @default("MELEE") @map("combat_style") /// MELEE (Corpo a Corpo) ou RANGED (À Distância)
  attackRange           Int               @default(60) @map("attack_range") /// Distância padrão de alcance do ataque em pixels
  baseAttributesJson       Json              @map("base_attributes_json") /// Ex: {"VIT":10,"STR":10,"INT":10,"WIS":10,"AGI":10,"DEX":10}
  growthPerLevelJson       Json              @map("growth_per_level_json")
  baseCombatAttributesJson Json?             @default("{}") @map("base_combat_attributes_json") /// Atributos de combate base não-derivados (ex: BATTLE_MOVE_SPEED: 180, ATTACK_SPEED: 1.0)
  skillIdsJson             Json              @default("[]") @map("skill_ids_json")
  isActive              Boolean           @default(true) @map("is_active")

  race                  Race              @relation(fields: [raceCode], references: [code])
  characters            PlayerCharacter[]

  @@map("class_templates")
}

/// Classificações procedurais futuras de encontros (desacopladas do template fixo do monstro).
model MonsterRarity {
  id                    Int     @id @default(autoincrement())
  code                  String  @unique
  nameI18nKey           String  @map("name_i18n_key")
  statMultiplier        Float   @default(1.0) @map("stat_multiplier")
  expMultiplier         Float   @default(1.0) @map("exp_multiplier")
  dropMultiplier        Float   @default(1.0) @map("drop_multiplier")
  visualScaleMultiplier Float   @default(1.0) @map("visual_scale_multiplier")
  spawnWeight           Int     @default(100) @map("spawn_weight")

  @@map("monster_rarities")
}

/// Templates de Monstros Inimigos e Pets Domáveis curados do mcrework.
model MonsterTemplate {
  id                 Int            @id @default(autoincrement())
  code               String         @unique
  mcreworkMonsterKey String         @map("mcrework_monster_key")
  nameI18nKey        String         @map("name_i18n_key")
  descriptionI18nKey String?        @map("description_i18n_key")
  groundOffsetY      Int            @default(0) @map("ground_offset_y")
  raceCode           String         @map("race_code")
  fixedElementCode   String         @map("fixed_element_code") /// Elemento fixo quando atua como monstro inimigo
  rarityTier         String         @default("F") @map("rarity_tier") /// Tier de Raridade do Monstro: SS, S, A, B, C, D, F
  combatStyle        String         @default("MELEE") @map("combat_style") /// MELEE (Corpo a Corpo) ou RANGED (À Distância)
  attackRange        Int            @default(60) @map("attack_range") /// Distância padrão de alcance do ataque em pixels
  isTamableAsPet     Boolean        @default(true) @map("is_tamable_as_pet")
  baseAttributesJson Json           @map("base_attributes_json") /// Pesos de VIT, STR, INT, WIS, AGI, DEX no Nv.1
  skillIdsJson       Json           @default("[]") @map("skill_ids_json")
  lootTableJson      Json           @default("[]") @map("loot_table_json")
  isActive           Boolean        @default(true) @map("is_active")

  race               Race           @relation(fields: [raceCode], references: [code])
  fixedElement       Element        @relation(fields: [fixedElementCode], references: [code])
  biomes             MonsterBiome[]
  tamedPets          CharacterPet[]

  @@map("monster_templates")
}

/// Tabela pivô que faz o vínculo procedural Mapa <-> Bioma <-> Monstro.
model MonsterBiome {
  id                Int             @id @default(autoincrement())
  monsterTemplateId Int             @map("monster_template_id")
  biomeId           Int             @map("biome_id")

  monsterTemplate   MonsterTemplate @relation(fields: [monsterTemplateId], references: [id], onDelete: Cascade)
  biome             Biome           @relation(fields: [biomeId], references: [id], onDelete: Cascade)

  @@unique([monsterTemplateId, biomeId])
  @@map("monster_biomes")
}

// ----------------------------------------------------------------------------
// 6. HABILIDADES (ATIVAS & PASSIVAS), BUFFS/DEBUFFS E EQUIPAMENTOS (16 + 6 SLOTS)
// ----------------------------------------------------------------------------

/// Habilidades de Combate em Tempo Real baseadas nos 7 Blocos Universais de Efeito (Modo Visual No-Code).
model SkillTemplate {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  nameI18nKey        String  @map("name_i18n_key")
  descriptionI18nKey String? @map("description_i18n_key")
  mcreworkIconKey    String? @map("mcrework_icon_key")
  castActionId       Int     @default(3) @map("cast_action_id") /// 3 = Ataque Físico, 7 = Conjuração/Skill, 4 = Guarda
  castMovement       String  @default("MELEE_ADVANCE") @map("cast_movement") /// MELEE_ADVANCE ou STAND_IN_PLACE
  mcreworkVfxKey     String? @map("mcrework_vfx_key") /// ID do efeito em assets/effects/catalog.json
  skillType          String  @default("ACTIVE") @map("skill_type") /// ACTIVE ou PASSIVE
  triggerType        String  @default("MANUAL") @map("trigger_type") /// MANUAL, PASSIVE_ALWAYS, ON_HIT, ON_CRIT, ON_DAMAGE_TAKEN, ON_KILL, INTERVAL_TICK
  mpCost             Int     @default(10) @map("mp_cost")
  apCost             Int     @default(2) @map("ap_cost") /// Custo de stamina/estamina de ação
  cooldownSeconds    Float   @default(0.0) @map("cooldown_seconds") /// Tempo de recarga em segundos (ex: 2.5s, 6.0s)
  cooldownTurns      Int     @default(0) @map("cooldown_turns") /// Compatibilidade legada
  castRange          Int     @default(160) @map("cast_range") /// Alcance máximo de conjuração em pixels
  aoeRadius          Int     @default(0) @map("aoe_radius") /// Raio de área de impacto em pixels (0 = alvo único)
  targetScope        String  @default("TARGET_PRIMARY") @map("target_scope") /// TARGET_PRIMARY, RANGED_ANY, ALL_ENEMIES, SELF, ALLY_SINGLE, ALLY_ALL, AOE_CIRCLE
  hitCount           Int     @default(1) @map("hit_count")
  effectBlocksJson   Json    @default("[]") @map("effect_blocks_json") /// Lista visual de blocos: DAMAGE, HEAL, SHIELD, STATUS, MOVE_SLOT, CLEANSE_DISPEL, RESOURCE
  isActive           Boolean @default(true) @map("is_active")

  @@map("skill_templates")
}

/// Templates de Buffs, Debuffs, Dano por Tempo (DoT) e Controles de Grupo (CC) em Tempo Real.
/// Não se ativam sozinhos: exigem uma Habilidade Ativa ou Passiva para serem aplicados no alvo.
model StatusEffectTemplate {
  id                   Int     @id @default(autoincrement())
  code                 String  @unique
  nameI18nKey          String  @map("name_i18n_key")
  descriptionI18nKey   String? @map("description_i18n_key")
  iconKey              String? @map("icon_key") /// Ícone informativo e exibido acima da cabeça do alvo na batalha
  mcreworkVfxKey       String? @map("mcrework_vfx_key") /// Efeito especial 2.5D acionado quando o gatilho do Buff/Debuff dispara
  isBuff               Boolean @default(true) @map("is_buff") /// true = Buff, false = Debuff
  triggerType          String  @default("CONTINUOUS_TICK") @map("trigger_type") /// CONTINUOUS_TICK, WHILE_ACTIVE, ON_APPLY, ON_HIT_TAKEN, ON_ATTACK, ON_EXPIRE
  maxStacks            Int     @default(1) @map("max_stacks")
  durationSeconds      Float   @default(5.0) @map("duration_seconds") /// Duração total do efeito em segundos
  tickIntervalSeconds  Float   @default(1.0) @map("tick_interval_seconds") /// Intervalo entre pulsos de DoT/HoT em segundos (padrão 1.0s)
  defaultDurationTurns Int     @default(2) @map("default_duration_turns") /// Compatibilidade legada
  statModifiersJson    Json    @default("{}") @map("stat_modifiers_json") /// Ex: {"ATK_PCT":20,"DEF_PCT":-15,"SPEED_PCT":10}
  dotHotFormulaJson    Json    @default("{}") @map("dot_hot_formula_json") /// Configuração visual de Dano/Cura por segundo/tick
  controlFlagsJson     Json    @default("[]") @map("control_flags_json") /// Ex: ["STUN", "SILENCE", "FREEZE"]
  effectBlocksJson     Json    @default("[]") @map("effect_blocks_json")
  isActive             Boolean @default(true) @map("is_active")

  @@map("status_effect_templates")
}

/// Os 16 Slots de Equipamento do Personagem + 6 Slots de Equipamento do Pet.
model EquipmentSlot {
  code        String         @id /// SHOULDER, HEAD, CHEST, BELT, LEGS, FEET, ORNAMENT_1, ORNAMENT_2, RING, NECKLACE, WEAPON_1, WEAPON_2, FISHING_ROD, FLYING_MOUNT, WINGS, FASHION e PET_EQUIP_1..6
  ownerType   String         @map("owner_type") /// CHARACTER (16 slots) ou PET (6 slots)
  slotIndex   Int            @map("slot_index") /// 1..16 para CHARACTER, 1..6 para PET
  nameI18nKey String         @map("name_i18n_key")
  items       ItemTemplate[]

  @@map("equipment_slots")
}

/// Catálogo de Itens, Equipamentos (Personagem e Pet), Consumíveis e Trocadores de Elemento.
model ItemTemplate {
  id                    Int            @id @default(autoincrement())
  code                  String         @unique
  nameI18nKey           String         @map("name_i18n_key")
  descriptionI18nKey    String         @map("description_i18n_key")
  mcreworkIconKey       String?        @map("mcrework_icon_key")
  itemCategory          String         @map("item_category") /// CHARACTER_EQUIPMENT, PET_EQUIPMENT, CONSUMABLE, ELEMENT_CHANGER, MATERIAL
  equipmentSlotCode     String?        @map("equipment_slot_code")
  rarityTier            String         @default("COMMON") @map("rarity_tier") /// SS, S, A, B, C, D, F, COMMON
  requiredLevel         Int            @default(1) @map("required_level")
  priceGold             Int            @default(0) @map("price_gold")
  maxStack              Int            @default(99) @map("max_stack") /// Quantidade máxima por pilha (1..99999)
  cooldownSec           Float          @default(0.0) @map("cooldown_sec") /// Tempo de recarga do item em segundos
  targetType            String         @default("SELF") @map("target_type") /// SELF, ALLY, ENEMY, PET, NONE
  effectType            String?        @map("effect_type") /// HEAL_HP, RESTORE_MP, BUFF_STATS, CHANGE_ELEMENT, TELEPORT, CATCH_PET, GRANT_EXP, MATERIAL, OPEN_CHEST
  effectValue           Float          @default(0.0) @map("effect_value") /// Valor numérico base do efeito (ex: +250 HP)
  reqClassCodesJson     Json           @default("[]") @map("req_class_codes_json") /// Classes que podem equipar (vazio = Todas)
  baseStatBonusesJson   Json           @default("{}") @map("base_stat_bonuses_json") /// VIT, STR, INT, WIS, AGI, DEX
  combatStatBonusesJson Json           @default("{}") @map("combat_stat_bonuses_json") /// PHYS_ATK, MAG_ATK, PHYS_DEF, MAG_DEF, BATTLE_MOVE_SPEED, ATTACK_SPEED, PHYS_ACCURACY, MAG_ACCURACY, PHYS_EVASION, MAG_EVASION, CRIT_CHANCE_PCT, CRIT_DAMAGE_PCT, ATTACK_RANGE
  specialEffectJson     Json           @default("{}") @map("special_effect_json")
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at")

  equipmentSlot         EquipmentSlot? @relation(fields: [equipmentSlotCode], references: [code])

  @@map("item_templates")
}

/// Catálogo de Montarias Voadoras (Sprites 2.5D, Tiers de Voo, Altitudes e Bônus).
model FlyingMountTemplate {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique
  mcreworkMountKey      String   @map("mcrework_mount_key") /// Ex: mount_dress_010019, mount_000003
  nameI18nKey           String   @map("name_i18n_key")
  descriptionI18nKey    String   @map("description_i18n_key")
  tier                  Int      @default(1) /// Tier 1 a 10
  rarityTier            String   @default("COMMON") @map("rarity_tier") /// SS, S, A, B, C, D, F, COMMON
  mountType             String   @default("FLYING") @map("mount_type") /// FLYING, DIVINE, MYTHIC, GLIDER
  speedBonusPct         Float    @default(30.0) @map("speed_bonus_pct") /// Bônus de velocidade no mapa/voo (%)
  flightAltitude        Float    @default(45.0) @map("flight_altitude") /// Altitude de voo em pixels acima do chão
  staminaMax            Int      @default(100) @map("stamina_max") /// Fôlego de voo / Estamina
  groundOffsetY         Int      @default(0) @map("ground_offset_y") /// Calibração de solo do sprite
  riderOffsetY          Int      @default(-40) @map("rider_offset_y") /// Ponto de montaria do cavaleiro
  requiredLevel         Int      @default(1) @map("required_level")
  priceGold             Int      @default(1000) @map("price_gold")
  baseAttributesJson    Json     @default("{}") @map("base_attributes_json") /// VIT, STR, INT, WIS, AGI, DEX
  combatAttributesJson  Json     @default("{}") @map("combat_attributes_json") /// BATTLE_MOVE_SPEED, PHYS_DEF, MAG_DEF, etc.
  specialSkillsJson     Json     @default("[]") @map("special_skills_json")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("flying_mount_templates")
}

// ----------------------------------------------------------------------------
// 7. CONTAS DE USUÁRIO, PERSONAGENS, PETS E FORMAÇÃO TÁTICA DE 10 SLOTS
// ----------------------------------------------------------------------------

/// Contas de usuário com permissões de acesso (PLAYER, GM, ADMIN, DEV).
model UserAccount {
  id                   Int               @id @default(autoincrement())
  username             String            @unique
  email                String            @unique
  passwordHash         String            @map("password_hash")
  role                 String            @default("PLAYER") /// PLAYER, GM, ADMIN, DEV
  tablePermissionsJson Json?             @map("table_permissions_json") /// Permissões por tabela para ADMIN: { [tableCode]: "NONE" | "READ" | "READ_WRITE" }
  locale               String            @default("pt-BR")
  createdAt            DateTime          @default(now()) @map("created_at")
  characters           PlayerCharacter[]

  @@map("user_accounts")
}

/// Personagem de um jogador (recebe Elemento inicial sorteado ao ser criado, alterável por item).
model PlayerCharacter {
  id                  Int              @id @default(autoincrement())
  userAccountId       Int              @map("user_account_id")
  name                String           @unique
  classTemplateId     Int              @map("class_template_id")
  elementCode         String           @map("element_code") /// Sorteado no início: 10% NEUTRAL, 20% cada ativo
  level               Int              @default(1)
  experience          BigInt           @default(0)
  unspentStatPoints   Int              @default(0) @map("unspent_stat_points")
  distributedStatsJson Json            @default("{\"VIT\":0,\"STR\":0,\"INT\":0,\"WIS\":0,\"AGI\":0,\"DEX\":0}") @map("distributed_stats_json")
  equippedItemsJson   Json             @default("{}") @map("equipped_items_json") /// Mapeia os 16 slots -> ID do item equipado
  currentMapId        Int?             @map("current_map_id")
  posX                Float            @default(400) @map("pos_x")
  posY                Float            @default(300) @map("pos_y")
  isCriminal          Boolean          @default(false) @map("is_criminal") /// Ativado se forçar PK em HOSTILE_ZONE
  isReborn            Boolean          @default(false) @map("is_reborn")

  userAccount         UserAccount      @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  classTemplate       ClassTemplate    @relation(fields: [classTemplateId], references: [id])
  pets                CharacterPet[]
  formation           ArenaFormation?
  questProgress       CharacterQuestProgress[]

  @@map("player_characters")
}

/// Templates de Pets Companheiros curados do mcrework para combate de ação ao lado do jogador.
model PetTemplate {
  id                       Int            @id @default(autoincrement())
  code                     String         @unique
  mcreworkPetKey           String         @map("mcrework_pet_key")
  nameI18nKey              String         @map("name_i18n_key")
  descriptionI18nKey       String?        @map("description_i18n_key")
  groundOffsetY            Int            @default(0) @map("ground_offset_y")
  raceCode                 String         @map("race_code")
  recommendedElementCode   String         @default("NEUTRAL") @map("recommended_element_code")
  rarityTier               String         @default("COMMON") @map("rarity_tier") /// SS, S, A, B, C, D, F
  role                     String         @default("BALANCED") @map("role") /// TANK, PHYS_DPS, MAG_DPS, HEALER, SUPPORT, BALANCED
  combatStyle              String         @default("MELEE") @map("combat_style") /// MELEE (Corpo a Corpo) ou RANGED (À Distância)
  attackRange              Int            @default(60) @map("attack_range") /// Distância padrão de alcance do ataque em pixels
  catchRatePct             Float          @default(25.0) @map("catch_rate_pct")
  baseAttributesJson       Json           @map("base_attributes_json") /// Pesos de VIT, STR, INT, WIS, AGI, DEX
  baseCombatAttributesJson Json?          @default("{}") @map("base_combat_attributes_json") /// Velocidade em Batalha, Vel. Ataque, Precisão, Desvio, Crítico
  skillIdsJson             Json           @default("[]") @map("skill_ids_json")
  isActive                 Boolean        @default(true) @map("is_active")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  race                     Race           @relation(fields: [raceCode], references: [code])
  recommendedElement       Element        @relation(fields: [recommendedElementCode], references: [code])
  characterPets            CharacterPet[]

  @@map("pet_templates")
}

/// Pets pertencentes a um Personagem (possuem elemento sorteado na obtenção e 6 slots de equipamento).
model CharacterPet {
  id                  Int              @id @default(autoincrement())
  characterId         Int              @map("character_id")
  monsterTemplateId   Int?             @map("monster_template_id")
  petTemplateId       Int?             @map("pet_template_id")
  nickname            String?
  elementCode         String           @map("element_code") /// Sorteado na criação/captura: 10% NEUTRAL, 20% cada ativo
  level               Int              @default(1)
  experience          BigInt           @default(0)
  equippedItemsJson   Json             @default("{}") @map("equipped_items_json") /// Mapeia PET_EQUIP_1..6 -> ID do item

  character           PlayerCharacter  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monsterTemplate     MonsterTemplate? @relation(fields: [monsterTemplateId], references: [id])
  petTemplate         PetTemplate?     @relation(fields: [petTemplateId], references: [id])

  @@map("character_pets")
}

/// Formação Tática de 10 Slots (Slots 1..5 = Vanguarda, Slots 6..10 = Retaguarda).
/// Regra validada pelo servidor: Solo/Dupla = 1 Char + até 3 Pets por jogador; 3 a 5 jogadores = 1 Char + 1 Pet por jogador.
model ArenaFormation {
  id          Int             @id @default(autoincrement())
  characterId Int             @unique @map("character_id")
  slotsJson   Json            @default("{}") @map("slots_json") /// Mapeia slot_1..slot_10 para a unidade posicionada

  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("arena_formations")
}

// ----------------------------------------------------------------------------
// 8. SISTEMA VISUAL NO-CODE DE MISSÕES / QUESTS (MAIN, SIDE, EPIC, PROFICIENCY)
// ----------------------------------------------------------------------------

/// Templates de Quests (Principal Linear por Capítulos/Episódios, Secundária, Épica e Proficiência).
model QuestTemplate {
  id                      Int                      @id @default(autoincrement())
  code                    String                   @unique /// Ex: quest_1, quest_2...
  titleI18nKey            String                   @map("title_i18n_key")
  descriptionI18nKey      String?                  @map("description_i18n_key")
  dialogueOfferI18nKey    String?                  @map("dialogue_offer_i18n_key")
  dialogueActiveI18nKey   String?                  @map("dialogue_active_i18n_key")
  dialogueCompleteI18nKey String?                  @map("dialogue_complete_i18n_key")

  questCategory           String                   @default("MAIN") @map("quest_category") /// MAIN, SIDE, EPIC, PROFICIENCY
  chapterOrder            Int                      @default(1) @map("chapter_order") /// Capítulo (1, 2, 3...)
  episodeOrder            Int                      @default(1) @map("episode_order") /// Episódio dentro do Capítulo (1-1, 1-2, 1-3...)
  minLevel                Int                      @default(1) @map("min_level")
  prerequisiteQuestId     Int?                     @map("prerequisite_quest_id")
  repeatType              String                   @default("ONCE") @map("repeat_type") /// ONCE, REPEATABLE, DAILY

  triggerType             String                   @default("NPC_INTERACT") @map("trigger_type") /// NPC_INTERACT, AUTO_ON_PREV_QUEST, ENTER_MAP, REACH_LEVEL, KILL_MONSTER_TRIGGER
  triggerConfigJson       Json                     @default("{}") @map("trigger_config_json") /// Configuração do gatilho de acionamento
  requirementsJson        Json                     @default("{}") @map("requirements_json") /// Requisitos obrigatórios para liberar/acionar a missão

  giverNpcId              Int?                     @map("giver_npc_id") /// ID do NpcTemplate que oferece a missão (! vermelho)
  giverMapId              Int?                     @map("giver_map_id") /// null = qualquer mapa com este NPC; ou ID de mapa específico
  turnInNpcId             Int?                     @map("turn_in_npc_id") /// ID do NpcTemplate que conclui a missão (? cinza / ? vermelho)
  turnInMapId             Int?                     @map("turn_in_map_id") /// null = qualquer mapa com este NPC; ou ID de mapa específico

  objectivesJson          Json                     @default("[]") @map("objectives_json") /// Blocos visuais de objetivos
  rewardsJson             Json                     @default("{}") @map("rewards_json") /// Blocos visuais de recompensas
  isActive                Boolean                  @default(true) @map("is_active")

  progressList            CharacterQuestProgress[]

  @@map("quest_templates")
}

/// Progresso de Quests por Personagem de Jogador.
model CharacterQuestProgress {
  id              Int             @id @default(autoincrement())
  characterId     Int             @map("character_id")
  questTemplateId Int             @map("quest_template_id")
  status          String          @default("IN_PROGRESS") /// IN_PROGRESS, COMPLETED_PENDING_TURNIN, TURNED_IN
  progressJson    Json            @default("[]") @map("progress_json") /// Contadores atuais de cada objetivo
  completedCount  Int             @default(0) @map("completed_count")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  character       PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questTemplate   QuestTemplate   @relation(fields: [questTemplateId], references: [id], onDelete: Cascade)

  @@unique([characterId, questTemplateId])
  @@map("character_quest_progress")
}

// ----------------------------------------------------------------------------
// 9. PROGRESSÃO DE NÍVEIS, EXPERIÊNCIA (XP) PROCEDURAL & BRACKETS DE 10 EM 10
// ----------------------------------------------------------------------------

/// Tabela de Progressão de Níveis e Experiência (XP) dos Personagens e Pets.
model LevelExperienceTemplate {
  level              Int      @id /// Nível (1, 2, 3... 100)
  experienceToNext   BigInt   @map("experience_to_next") /// XP necessária para o próximo nível
  totalExperience    BigInt   @map("total_experience") /// XP acumulada total desde o nível 1
  statPointsReward   Int      @default(5) @map("stat_points_reward") /// Pontos de status concedidos ao atingir o nível
  skillPointsReward  Int      @default(1) @map("skill_points_reward") /// Pontos de habilidade concedidos
  hpBonus            Int      @default(20) @map("hp_bonus") /// Bônus base de HP do nível
  mpBonus            Int      @default(10) @map("mp_bonus") /// Bônus base de MP do nível
  bracketTier        Int      @default(1) @map("bracket_tier") /// Faixa de 10 níveis (1: 1-10, 2: 11-20, etc.)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("level_experience_templates")
}
