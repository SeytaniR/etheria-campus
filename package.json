{
  "name": "etheria-campus",
  "version": "0.2.0",
  "private": true,
  "description": "Etheria Campus - Modern Tactical 2.5D MMORPG Monorepo (Authoritative Server, Low-Code Admin Studio & Pixi.js WebGL/APK Client)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm --workspace=@etheria/database run db:generate",
    "db:push": "npm --workspace=@etheria/database run db:push",
    "db:seed": "npm --workspace=@etheria/database run db:seed",
    "db:snapshot:export": "npm --workspace=@etheria/database run snapshot:export",
    "db:snapshot:restore": "npm --workspace=@etheria/database run snapshot:restore",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
