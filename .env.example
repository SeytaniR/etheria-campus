# @file .env.example
# @module @etheria/infra
# @description Variáveis de ambiente padrão para conexão com PostgreSQL, Redis, Servidor Autoritário e Proteção da Rota /admin.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/etheria_campus?schema=public"
POSTGRES_USER="etheria"
POSTGRES_PASSWORD="etheria_secret_pw"
POSTGRES_DB="etheria_campus"
POSTGRES_PORT=5435
REDIS_URL="redis://localhost:6385"
PORT=4000
MCREWORK_ASSETS_BASE_URL="https://seytanir.github.io/mcrework/assets"

# Credenciais exclusivas para acesso via LOCALHOST (127.0.0.1 / localhost).
# Acessos externos (LAN, Celular, Túnel, VPS) bloqueiam esta senha e exigem conta cadastrada no CRUD do banco.
ADMIN_LOCAL_USERNAME="admin"
ADMIN_LOCAL_PASSWORD="etheria_local_admin_2026"
ADMIN_SESSION_SECRET="etheria_super_secret_hmac_key_change_in_prod_2026"
