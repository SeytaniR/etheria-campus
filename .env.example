# @file .env.example
# @module @etheria/infra
# @description Variáveis de ambiente padrão para conexão com PostgreSQL, Redis e Servidor Autoritário.

DATABASE_URL="postgresql://etheria:etheria_secret_pw@localhost:5432/etheria_campus?schema=public"
POSTGRES_USER="etheria"
POSTGRES_PASSWORD="etheria_secret_pw"
POSTGRES_DB="etheria_campus"
POSTGRES_PORT=5432
REDIS_URL="redis://localhost:6379"
PORT=3000
MCREWORK_ASSETS_BASE_URL="https://seytanir.github.io/mcrework/assets"
